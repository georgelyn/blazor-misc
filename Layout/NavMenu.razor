@inject NavigationManager Nav
@inject IStringLocalizer<Resources> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Miscellaneous</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        @foreach (var item in navItems)
        {
            <div class="nav-item px-3">
                @if (item.Children != null && item.Children.Any())
                {
                    <button class="nav-link strings-menu" 
                        @onclick="(() => ToggleMenu(item.Key))"
                        @onclick:stopPropagation>
                        <span class="bi material-icons">@item.Icon</span> @item.Title
                        <span class="material-icons submenu-icon @(expandedMenu == item.Key ? "rotate" : "")">
                            expand_more
                        </span>
                    </button>

                    @if (expandedMenu == item.Key)
                    {
                        <nav class="nav flex-column ms-4">
                            @foreach (var child in item.Children)
                            {
                                <NavLink class="nav-link" href="@child.Href"> @child.Title</NavLink>
                            }
                        </nav>
                    }
                }
                else {
                    <NavLink class="nav-link" href="@item.Href" Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <span class="bi material-icons">@item.Icon</span> @item.Title
                    </NavLink>
                }
            </div>
        }

        @if (isMobile) {
            <LanguageSelector IsMobile=true />
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private string? expandedMenu = string.Empty;
    private IEnumerable<NavItem> navItems = Array.Empty<NavItem>();
    private bool isMobile = false;

    protected override void OnInitialized()
    {
        SetNavItems();
        var currentPath = Nav.ToBaseRelativePath(Nav.Uri);
        var menu = navItems.FirstOrDefault(n => n.Children != null && n.Children.Any(c => c.Href == currentPath));
        if (menu != null)
            expandedMenu = menu.Key;

        isMobile = !collapseNavMenu;
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
        isMobile = !collapseNavMenu;
    }

    private void ToggleMenu(string key)
    {
        if (expandedMenu == key)
            expandedMenu = null;
        else
            expandedMenu = key;
    }

    private void SetNavItems()
    {
        navItems = new List<NavItem>()
        {
            new (@L["Home"], "home", "/", "home"),
            new (@L["NavConverter"], "convert", "convert", "data_object"),
            new (@L["NavFormatter"], "formatter", "formatter", "format_align_justify"),
            new (@L["NavStringUtilities"], "strings", "", "text_format", new List<NavItem>() 
            {
                new(@L["NavStringSplitJoin"], "strings-split", "strings/split"),
                new(@L["NavStringReplace"], "strings-replace", "strings/replace"),
                new(@L["NavStringOrder"], "strings-order", "strings/order"),
                new(@L["NavStringUnique"], "strings-unique", "strings/unique"),
            }),
            new(@L["NavImageSearch"], "images", "images", "image_search"),
        };
    }
}
