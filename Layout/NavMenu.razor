@inject NavigationManager Nav

@inject IStringLocalizer<Resources> L

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Miscellaneous</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi material-icons">home</span> @L["Home"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="convert">
                <span class="bi material-icons">data_object</span> @L["NavConverter"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="formatter">
                <span class="bi material-icons">format_align_justify</span> @L["NavFormatter"]
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <button class="nav-link strings-menu" @onclick="ToggleStringsMenu" @onclick:stopPropagation>
                <span class="bi material-icons">text_format</span> @L["NavStringUtilities"]
                <span class="material-icons submenu-icon @(showStringsMenu ? "rotate" : "")">
                    expand_more
                </span>
            </button>

            @if (showStringsMenu)
            {
                <nav class="nav flex-column ms-4">
                    <NavLink class="nav-link" href="strings/split"> @L["NavStringSplitJoin"] </NavLink>
                    <NavLink class="nav-link" href="strings/replace"> @L["NavStringReplace"] </NavLink>
                    <NavLink class="nav-link" href="strings/order"> @L["NavStringOrder"] </NavLink>
                    <NavLink class="nav-link" href="strings/unique"> @L["NavStringUnique"] </NavLink>
                </nav>
            }
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="images">
                <span class="bi material-icons">image_search</span> @L["NavImageSearch"]
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private bool showStringsMenu;

    protected override void OnInitialized()
    {
        var currentPath = Nav.ToBaseRelativePath(Nav.Uri);
        if (currentPath.StartsWith("strings"))
        {
            showStringsMenu = true;
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    void ToggleStringsMenu() 
    {
        showStringsMenu = !showStringsMenu;
    } 
}
