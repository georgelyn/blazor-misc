@using Misc.Services
@inherits LayoutComponentBase
@inject IMessagesService MessagesService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 mb-3">
            @* <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a> *@
        </div>

        <article class="mcontainer px-4 mb-4 pb-4">
            @Body

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="container">
                    <div class="message-area shadow mt-5">
                        @message
                    </div>
                </div>
            }
        </article>
    </main>
</div>

@code {
    private string? message;

    protected override void OnInitialized()
    {
        MessagesService.OnMessageChanged += HandleMessage;
    }

    public void Dispose()
    {
        MessagesService.OnMessageChanged -= HandleMessage;
    }

    private void HandleMessage(string? msg, bool? isError = false)
    {
        message = msg;
        InvokeAsync(StateHasChanged);
    }
}