@using System.ComponentModel.DataAnnotations.Schema

<div class="container-area">
    <div class="mb-3">
        <label for="container-txt" class="form-label mb-3">@Title</label>
        <textarea class="form-control" id="container-txt" 
            placeholder="@Placeholder"
            rows="@Rows" 
            value="@Value"
            @oninput="OnInput"></textarea>
        @if (OptionalContainerContent != null)
        {
            <div class="optional-content mt-3">
                @OptionalContainerContent
            </div>
        }
    </div>
    <div class="container-area_btn mt-2">
        @foreach (var button in Buttons.OrderBy(b => b.Order))
        {
            <button type="button" class="btn btn-primary" @onclick="button.Event">@button.Text</button>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;
    [Parameter] 
    public EventCallback<string> ValueChanged { get; set; }
    [Parameter]
    public string Value { get; set; } = string.Empty;
    [Parameter]
    public IEnumerable<Button> Buttons { get; set; } = Array.Empty<Button>();
    [Parameter]
    public RenderFragment? OptionalContainerContent { get; set; }
    [Parameter]
    public int Rows { get; set; } = 10;
    [Parameter]
    public string Placeholder { get; set; } = string.Empty;

    private async Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(Value);
    }
}