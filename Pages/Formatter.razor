@page "/formatter"

@using Misc.Services
@using System.Threading.Tasks
@using System.Text.RegularExpressions
@inject IMessagesService MessagesService
@inject IStringLocalizer<Resources> L

<PageTitle>@L["PageFormatter"]</PageTitle>

<div class="container">

    <TextAreaWithAction 
        Title="@L["FormatterTextTitle"]" 
        @bind-Value="@jsonString" 
        Buttons="buttons" />

    @if (!string.IsNullOrWhiteSpace(json))
    {
        <ResponseWithAction>
            <MainContent>
                <pre id="copy-text" class="copy-text">@json</pre>    
            </MainContent>
            <ActionContent>
                <button type="button" class="btn btn-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="@L["ConverterCopyText"]"
                    @onclick="CopyText">
                    @(isCopied ? @L["ConverterCopyDoneBtn"] : @L["Copy"])
                </button>
            </ActionContent>
        </ResponseWithAction>
    }
</div>

@code {
    [Inject]
    private IJSRuntime? JS { get; set; }
    private string jsonString = string.Empty;
    private string json = string.Empty;
    private bool isCopied;
    private string notValidMessage = string.Empty;
    private static readonly Regex _regexWhitespace = new Regex(@"\s+");
    private List<Button> buttons = new();

    protected override void OnInitialized()
    {
        buttons = new()
        {
            new Button(1, @L["Format"], EventCallback.Factory.Create(this, FormatJson)), 
            new Button(2, @L["RemoveWhiteSpace"], EventCallback.Factory.Create(this, RemoveSpaces)), 
        };

        notValidMessage = @L["JsonNotValid"];
    }

    private async Task FormatJson()
    {
        var (response, exception) = Helpers.FormatJson(jsonString);
        if (exception != null)
        {
            await MessagesService.DisplayMessageAsync($"{notValidMessage}{Environment.NewLine}{exception.Message}");
        } 
        else
        {
            json = response ?? string.Empty;
        }
    }

    private async Task RemoveSpaces()
    {
        await FormatJson();
        json = _regexWhitespace.Replace(json, string.Empty);
    }

    private async Task CopyText()
    {
        isCopied = true;
        await JS!.InvokeVoidAsync("copyToClipboard");
        await Task.Delay(3000);
        isCopied = false;
    }
}