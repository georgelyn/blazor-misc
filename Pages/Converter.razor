@page "/convert"

@using System.Text
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations.Schema
@inject IStringLocalizer<Resources> L

<PageTitle>@L["PageConverter"]</PageTitle>

<div class ="container">
    <div class="mb-4">
        <Info Text="@L["ConverterMainInfo"]" />
    </div>

    <TextAreaWithAction 
        Title="@L["ConverterTextTitle"]" 
        @bind-Value="@classString" 
        Buttons="buttons" />

    @if (!string.IsNullOrWhiteSpace(json))
    {
        <ResponseWithAction>
            <MainContent>
                <pre id="copy-text" class="copy-text">@json</pre>    
            </MainContent>
            <ActionContent>
                <button type="button" class="btn btn-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="@L["ConverterCopyText"]"
                    @onclick="CopyText">
                    @(isCopied ? @L["ConverterCopyDoneBtn"] : @L["Copy"])
                </button>
                <button type="button" class="btn btn-secondary" data-bs-toggle="tooltip" data-bs-placement="top" title="@L["ConverterFormatJson"]"
                    @onclick="FormatJson">
                    @L["Format"]
                </button>
            </ActionContent>
        </ResponseWithAction>
    }
</div>

@code {
    [Inject]
    private IJSRuntime? JS { get; set; }
    private string classString = string.Empty;
    private string json = string.Empty;
    private bool isCopied = false;
    private string dataTypePattern = @"public\s+([\w<>\[\],\s?]+)\s+(\w+)";
    private List<Button> buttons = new ();

    protected override void OnInitialized()
    {
        buttons = new()
        {
            new Button(1, L["Convert"], EventCallback.Factory.Create(this, Convert))
        };
    }

    private void Convert()
    {
        json = string.Empty;
        if (string.IsNullOrWhiteSpace(classString))
            return;

        string[] lines = classString.Split(new string[] { Environment.NewLine }, StringSplitOptions.None);
        var response = new List<string>();
        foreach (var line in lines)
        {
            var match = Regex.Match(line, dataTypePattern);
            if (!match.Success)
                continue;

            var dataType = match.Groups[1].Value.Trim(); 
            string propertyName = match.Groups[2].Value.Trim();
            if (string.IsNullOrWhiteSpace(propertyName) || !line.Contains("get;"))
                continue;

            response.Add($@"""{char.ToLower(propertyName[0]) + propertyName.Substring(1)}"":""{Helpers.GetMappedDataType(dataType)}""");
        }

        var responseString = string.Join(",", response.ToArray());
        if (!string.IsNullOrWhiteSpace(responseString))
        {
            json = "{" + responseString + "}";
        }
    }

    private async Task CopyText()
    {
        isCopied = true;
        await JS!.InvokeVoidAsync("copyToClipboard");
        await Task.Delay(3000);
        isCopied = false;
    }

    private void FormatJson()
    {
        var (response, _) = Helpers.FormatJson(json);
        json = response ?? string.Empty;
    }
}