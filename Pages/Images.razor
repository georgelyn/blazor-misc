@page "/images"

@using Misc.Services
@using System.Threading.Tasks
@using Misc.Shared.Components
@using Misc.Shared.Models
@using System.Reflection.Metadata
@using Microsoft.Extensions.Localization
@using Misc.Resources
@inject IStringLocalizer<Resources> L
@inject IImagesService ImagesService
@inject IMessagesService MessagesService
@inject IJSRuntime JS

<PageTitle>@L["PageImageSearch"]</PageTitle>

<div class="container">
    <ImageSearch Title="@L["ImageSearchTextTitle"]" @bind-Value="keyword" Button="button" Placeholder="@placeholder" />

    @if (isLoading)
    {
        <div class="d-flex justify-content-center align-items-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">@L["Loading"]...</span>
            </div>
        </div>
    }
    else if (images != null && images.Any())
    {
        <Gallery Images="images" CurrentPage="currentPage" TotalPages="totalPages" OnPageChanged="page => Search(page)" />
    }
</div>

@code {
    private string? keyword;
    private IEnumerable<ImageObject> images = Array.Empty<ImageObject>();
    private Button? button;
    private int currentPage = 1;
    private int pageSize = 16;
    private int totalPages = 0;
    private string browserLanguage = "en";
    private bool isLoading;
    private string? placeholder = null;

    protected override void OnInitialized()
    {
        this.button = new Button(1, @L["SearchOnWeb"], EventCallback.Factory.Create(this, () => Search(1)));
    }

    protected override async Task OnInitializedAsync()
    {
        var lang = await JS.InvokeAsync<string>("eval", "navigator.language");
        if (string.IsNullOrWhiteSpace(lang) || lang.Split("-").Length == 0)
            browserLanguage = "en";
        else
            browserLanguage = lang.Split("-")[0];

        placeholder = GetPlaceholder();
    }

    private async Task Search(int page)
    {
        currentPage = page;
        if (string.IsNullOrWhiteSpace(keyword))
            keyword = placeholder;

        try
        {
            isLoading = true;
            var response = await ImagesService.GetImagesByKeywordAsync(keyword!, currentPage, pageSize, browserLanguage!);
            if (response == null || response?.TotalHits == 0)
            {
                Reset();
                await MessagesService.DisplayMessageAsync(@L["ImagesNotFound"]);
            }
            else
            {
                totalPages = (int)Math.Ceiling((double)response!.TotalHits / pageSize);
                images = response.Hits!;
            }
        }
        catch
        {
            Reset();
            await MessagesService.DisplayMessageAsync(@L["AnErrorHasOccurred"]);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Reset()
    {
        isLoading = false;
        images = [];
        StateHasChanged();
    }

    private string GetPlaceholder()
    {
        switch (browserLanguage)
        {
            case "es":
                return "gatito naranja";
            case "en":
                return "orange kitty";
            default:
                return string.Empty;
        }
    }
}