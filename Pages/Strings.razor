@page "/strings"

@inject IStringLocalizer<Resources> L

<PageTitle>@L["PageStringUtilities"]</PageTitle>

<div class="container d-flex flex-column gap-5">
    <TextAreaWithAction Title="@L["StringSplitJsonTextTitle"]" @bind-Value="splitJoinValue" Buttons="splitJoinButtons">

        <OptionalContainerContent>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-end container-input-label">
                    <label for="split-choice-txt" class="col-sm-2 col-form-label max-w-100px">@L["Delimiter"]</label>
                    <input type="text" class="form-control max-w-300px" id="split-choice-txt"
                        placeholder="@L["SplitPlaceholder"]" @bind="delimiter">
                </div>
            </div>
        </OptionalContainerContent>
    </TextAreaWithAction>

    <TextAreaWithAction Title="@L["StringReplaceTextTitle"]" @bind-Value="replaceValue" Buttons="replaceButtons">

        <OptionalContainerContent>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex justify-content-end container-input-label">
                    <label for="replace-from-txt" class="col-sm-2 col-form-label max-w-100px">@L["Replace"]</label>
                    <input type="text" class="form-control max-w-300px" id="replace-from-txt" @bind="replaceFrom">
                </div>
                <div class="d-flex justify-content-end container-input-label">
                    <label for="replace-with-txt" class="col-sm-2 col-form-label max-w-100px">@L["With"]</label>
                    <input type="text" class="form-control max-w-300px" id="replace-with-txt" @bind="replaceWith">
                </div>
            </div>
        </OptionalContainerContent>
    </TextAreaWithAction>
</div>

@code {
    private string splitJoinValue = string.Empty;
    private string replaceValue = string.Empty;
    private string delimiter = string.Empty;
    private string replaceFrom = string.Empty;
    private string replaceWith = string.Empty;
    private List<Button> splitJoinButtons = new();
    private List<Button> replaceButtons = new();

    protected override void OnInitialized()
    {
        this.splitJoinButtons = new List<Button>()
        {
            new Button(1, @L["Split"], EventCallback.Factory.Create(this, Split)),
            new Button(2, @L["Join"], EventCallback.Factory.Create(this, Join)),
        };

        this.replaceButtons = new List<Button>()
        {
            new Button(1, @L["Replace"], EventCallback.Factory.Create(this, Replace)),
        };
    }

    private void Split()
    {
        if (!string.IsNullOrWhiteSpace(splitJoinValue))
        {
            if (string.IsNullOrWhiteSpace(delimiter))
                delimiter = ",";

            splitJoinValue = string.Join(Environment.NewLine, splitJoinValue.Split(delimiter));
        }
    }

    private void Join()
    {
        if (!string.IsNullOrWhiteSpace(splitJoinValue))
        {
            if (string.IsNullOrWhiteSpace(delimiter))
                delimiter = ",";

            string[] lines = splitJoinValue.Split(new string[] { Environment.NewLine }, StringSplitOptions.RemoveEmptyEntries);
            splitJoinValue = string.Join(delimiter, lines);
        }
    }

    private void Replace()
    {
        if (!string.IsNullOrWhiteSpace(replaceValue))
        {
            replaceValue = replaceValue.Replace(replaceFrom, replaceWith);
        }
    }
}